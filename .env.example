# Credenziali app Telegram, da https://my.telegram.org (gratuito)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# StringSession generata una tantum con generate_session.py
TELEGRAM_SESSION=

# ID numerico del supergruppo Telegram (forum con topic). Puoi ottenerlo
# lanciando generate_session.py, che stampa la lista delle tue chat.
TELEGRAM_GROUP_ID=

# Chiave API OpenAI
OPENAI_API_KEY=

# Modello OpenAI usato per i riassunti. Vuoto = default (gpt-5.6-luna).
# Nota: sui modelli di ragionamento (famiglia gpt-5, serie o*) la
# temperatura non e' regolabile e viene omessa dalle chiamate.
OPENAI_MODEL=gpt-5.6-luna

# Il disegno della vignetta del giorno, generato sull'apertura: il fatto
# decide dove sono i due e cosa stanno facendo, e la scena cambia a ogni
# edizione. A 0 il disegno non si genera e si pesca dalla biblioteca di
# assets/vignette (gratis, ma sempre la stessa rotazione).
GENERATE_AI_VIGNETTA=1

# Il modello che disegna. Vuoto = gpt-image-2.
OPENAI_IMAGE_MODEL=

# Il disegno esce in bianco e nero, come il resto della pagina: inchiostro
# e carta avorio, nessun colore in piu'. La conversione e' fatta dopo la
# generazione (report/inchiostro.py), quindi vale qualunque cosa consegni
# il modello. A 0 resta la tavolozza del modello.
VIGNETTA_BIANCO_E_NERO=1

# Destinazione del report: "me" invia in Saved Messages/DM con te stesso.
# In futuro: impostare l'ID del gruppo (uguale a TELEGRAM_GROUP_ID) e
# valorizzare REPORT_TOPIC_ID per postare in un topic dedicato del gruppo.
REPORT_DESTINATION=me
REPORT_TOPIC_ID=

# Timezone usata per definire i confini del "giorno" da riepilogare
REPORT_TIMEZONE=Europe/Rome

# Dove arriva il conto di quanto e' costata l'edizione: un messaggio a
# parte, dopo il gazzettino, con i token e i dollari davvero spesi. E' una
# variabile sua e non segue REPORT_DESTINATION, perche' il giornale puo'
# uscire nel topic del gruppo mentre il conto resta privato.
#   me (default) = Messaggi salvati    off = non mandare niente
#   group        = il gruppo           <id> = un'altra chat
SPESA_DESTINATION=me

# Listino del modello, in dollari per milione di token. Vuoti = i prezzi
# di report/spesa.py (0.20 e 1.20, gpt-5.6-luna). Da valorizzare se i
# prezzi cambiano o se OPENAI_MODEL punta a un altro modello: i token
# vengono contati veri in ogni caso, ma il cambio lo diamo noi.
PREZZO_INPUT=
PREZZO_OUTPUT=

# Il bot che trascrive i vocali non e' una persona: le sue trascrizioni
# vengono attribuite a chi ha mandato il vocale, e i suoi riepiloghi su
# richiesta vengono ignorati. Elenco separato da virgole, confronto per
# sottostringa e senza distinzione fra maiuscole e minuscole.
SCRIBE_BOT_NAMES=scribacchino

# Come si aprono i riepiloghi di quel bot, per distinguerli dalle
# trascrizioni. Da ritoccare se il bot cambia formula. Vuoto = default
# (riepilogo, riassunto, recap, sintesi, ...).
SCRIBE_SUMMARY_MARKERS=

# A quale sezione appartiene ogni topic. Il punto e virgola separa le
# sezioni, l'uguale il nome dai suoi topic, la virgola i topic fra loro.
# Un topic non elencato finisce in "Altro", quindi aprirne uno nuovo nel
# gruppo non rompe niente. Vuoto = la mappa di report/sections.py.
#   REPORT_SECTIONS=Napoli=SSC Napoli,Match Day;Calcio=Le Altre Squadre
# L'ordine scritto qui NON e' l'ordine in pagina: le sezioni si ordinano
# da sole, per messaggi della giornata.
REPORT_SECTIONS=

# Gruppi di topic con la stessa forma, che vanno impaginati insieme in un
# blocco compatto invece che come articoli separati (le otto leghe di
# fantacalcio). Stessa sintassi. Vuoto = le famiglie di report/sections.py.
#   REPORT_SECTION_FAMILIES=Le Serie=Serie Ah,Serie TvB,Serie X
REPORT_SECTION_FAMILIES=

# --- Bot a comandi (Telegram Bot API, separato dalla sessione utente sopra) ---
# Non legge la cronologia del gruppo: risponde solo ai comandi in chat e
# gestisce l'invito/le domande dell'intervista settimanale.

# Token del bot creato con BotFather (@BotFather su Telegram)
TELEGRAM_BOT_TOKEN=

# URL pubblico del servizio una volta deployato (es. https://nome.onrender.com).
# Vuoto = il bot gira in polling, comodo per lo sviluppo in locale.
TELEGRAM_BOT_WEBHOOK_URL=

# Stringa segreta a scelta: Telegram la rimanda su ogni chiamata al webhook,
# cosi' il bot puo' verificare che non sia una richiesta contraffatta.
TELEGRAM_BOT_WEBHOOK_SECRET=

# Un'altra stringa segreta a scelta: protegge l'endpoint /trigger/intervista,
# chiamato una volta a settimana da GitHub Actions per far scegliere e
# contattare il candidato dell'intervista.
TELEGRAM_BOT_TRIGGER_SECRET=

# Percorso del file SQLite dove il bot salva iscritti/estrazioni/interviste.
# Vuoto = bot/data/bot.sqlite3
BOT_DB_PATH=
