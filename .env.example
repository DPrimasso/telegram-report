# Credenziali app Telegram, da https://my.telegram.org (gratuito)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# StringSession generata una tantum con generate_session.py
TELEGRAM_SESSION=

# ID numerico del supergruppo Telegram (forum con topic). Puoi ottenerlo
# lanciando generate_session.py, che stampa la lista delle tue chat.
TELEGRAM_GROUP_ID=

# Chiave API OpenAI
OPENAI_API_KEY=

# Modello OpenAI usato per i riassunti
OPENAI_MODEL=gpt-4o-mini

# Illustrazione generata come ultima ricaduta per l'apertura, quando non
# c'e' ne' una foto del gruppo ne' una copertina YouTube. Spenta di
# default: aggiunge un costo e una latenza al job notturno, e l'apertura
# senza immagine e' comunque una pagina valida. Vedi docs/grafica.md.
ILLUSTRATION_FALLBACK=
OPENAI_IMAGE_MODEL=gpt-image-2

# Formato dell'illustrazione. Il default (1600x624) e' il rapporto dello
# slot dell'apertura: chiedendo un 16:9 si perde quasi un terzo
# dell'altezza nel ritaglio. Con gpt-image-1, che accetta solo misure
# fisse, usare 1536x1024.
OPENAI_IMAGE_SIZE=

# Destinazione del report: "me" invia in Saved Messages/DM con te stesso.
# In futuro: impostare l'ID del gruppo (uguale a TELEGRAM_GROUP_ID) e
# valorizzare REPORT_TOPIC_ID per postare in un topic dedicato del gruppo.
REPORT_DESTINATION=me
REPORT_TOPIC_ID=

# Timezone usata per definire i confini del "giorno" da riepilogare
REPORT_TIMEZONE=Europe/Rome

# Il bot che trascrive i vocali non e' una persona: le sue trascrizioni
# vengono attribuite a chi ha mandato il vocale, e i suoi riepiloghi su
# richiesta vengono ignorati. Elenco separato da virgole, confronto per
# sottostringa e senza distinzione fra maiuscole e minuscole.
SCRIBE_BOT_NAMES=scribacchino

# Come si aprono i riepiloghi di quel bot, per distinguerli dalle
# trascrizioni. Da ritoccare se il bot cambia formula. Vuoto = default
# (riepilogo, riassunto, recap, sintesi, ...).
SCRIBE_SUMMARY_MARKERS=
